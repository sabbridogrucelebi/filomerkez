{
  "expo": {
    "name": "FiloMERKEZ",
    "slug": "mobile-app",
    "version": "1.0.14",
    "description": "Filo ve servis yönetimi: araç, personel, sefer, yakıt, bakım ve ceza takibi tek uygulamada.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#3B82F6",
    "assetBundlePatterns": [
      "**/*"
    ],
    "locales": {
      "tr": "./locales/tr.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.celebiturizm.filomerkez",
      "buildNumber": "14",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": [
          "tr"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "FiloMERKEZ, anlık seferinizi izleyebilmek, hızınızı hesaplamak ve öğrenci/personel taşıma rotalarını haritada çizebilmek için konumunuza erişim izni gerektirir.",
        "NSCameraUsageDescription": "FiloMERKEZ, araç fotoğrafları, belge ve yakıt fişlerini çekebilmeniz için kameranıza erişim izni gerektirir.",
        "NSPhotoLibraryUsageDescription": "FiloMERKEZ, galerinizdeki araç belgelerini ve fişleri yükleyebilmeniz için fotoğraflarınıza erişim izni gerektirir.",
        "NSPhotoLibraryAddUsageDescription": "FiloMERKEZ, fotoğrafları cihazınıza kaydetmek için izin gerektirir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.celebiturizm.filomerkez",
      "versionCode": 14,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "tr",
      "meta": {
        "charset": "utf-8"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FiloMERKEZ, anlık seferinizi izleyebilmek, hızınızı hesaplamak ve öğrenci/personel taşıma rotalarını haritada çizebilmek için konumunuza erişim izni gerektirir.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FiloMERKEZ, galerinizdeki araç belgelerini ve fişleri yükleyebilmeniz için fotoğraflarınıza erişim izni gerektirir.",
          "cameraPermission": "FiloMERKEZ, araç fotoğrafları, belge ve yakıt fişlerini çekebilmeniz için kameranıza erişim izni gerektirir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "dbfb1961-a8bc-494d-9e16-ecf0469bef2c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dbfb1961-a8bc-494d-9e16-ecf0469bef2c",
      "fallbackToCacheTimeout": 0
    }
  }
}
